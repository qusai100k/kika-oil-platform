generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STORE_OWNER
  CONTENT_MANAGER
  ORDER_MANAGER
  SPECIALIST
  SUPER_ADMIN
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  DELIVERY_FAILED
  RETURN_REQUESTED
  RETURNED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  MANUAL_BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AWAITING_TRANSFER
  PAYMENT_REVIEW
  NOT_REQUIRED
  PAID
  CANCELLED
}

enum CouponType {
  FIXED
  PERCENTAGE
}

enum InventoryMovementType {
  ORDER_DECREMENT
  CANCELLATION_RESTORE
  MANUAL_ADJUSTMENT
  RESTOCK
  DAMAGE
  CORRECTION
}

enum CancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  REFERRED
  COMPLETED
}

enum RecommendationStatus {
  RECOMMENDED
  NEEDS_INFORMATION
  REFERRED
  NO_RECOMMENDATION
  FAILED
}

enum BookingStatus {
  DRAFT
  HELD
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
  PAYMENT_FAILED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_TEXT
  BOOLEAN
  CONSENT
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  email                String                     @unique
  emailVerified        Boolean                    @default(false)
  name                 String?
  role                 UserRole                   @default(CUSTOMER)
  image                String?
  deletedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  accounts             Account[]
  sessions             Session[]
  customerProfile      CustomerProfile?
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  reviews              Review[]
  assessments          SkinAssessment[]
  recommendations      Recommendation[]
  specialistProfile    SpecialistProfile?
  bookings             ConsultationBooking[]      @relation("CustomerBookings")
  notifications        Notification[]
  consents             ConsentRecord[]
  auditEvents          AuditLog[]                 @relation("AuditActor")
  couponRedemptions    CouponRedemption[]
  cancellationRequests OrderCancellationRequest[]
  inventoryAdjustments InventoryMovement[]        @relation("InventoryActor")
  moderatedReviews     Review[]                   @relation("ReviewModerator")
  confirmedPayments    Order[]                    @relation("PaymentConfirmer")

  @@index([role, deletedAt])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  phone     String?
  birthYear Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  label       String?
  recipient   String
  phone       String
  countryCode String
  city        String
  area        String?
  street      String
  building    String?
  postalCode  String?
  notes       String?
  isDefault   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt])
}

model ProductCategory {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  nameAr        String
  descriptionAr String?
  status        RecordStatus @default(DRAFT)
  sortOrder     Int          @default(0)
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  products      Product[]
}

model Product {
  id                    String                     @id @default(uuid()) @db.Uuid
  categoryId            String                     @db.Uuid
  slug                  String                     @unique
  nameAr                String
  shortDescriptionAr    String?
  descriptionAr         String?
  usageAr               String?
  safetyNoticeAr        String?
  storageInstructionsAr String?
  seoTitleAr            String?
  seoDescriptionAr      String?
  sortOrder             Int                        @default(0)
  status                ProductStatus              @default(DRAFT)
  isFeatured            Boolean                    @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  category              ProductCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  images                ProductImage[]
  ingredients           ProductIngredient[]
  skinCompatibility     ProductSkinCompatibility[]
  concernMappings       ProductConcernMapping[]
  recommendationItems   RecommendationItem[]
  reviews               Review[]

  @@index([categoryId, status, deletedAt])
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @db.Uuid
  sku                String              @unique
  nameAr             String
  sizeLabel          String?
  price              Decimal             @db.Decimal(12, 2)
  currency           String              @db.VarChar(3)
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  sortOrder          Int                 @default(0)
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId, isActive, deletedAt])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  url        String
  altAr      String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  mimeType   String?
  fileSize   Int?
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Ingredient {
  id            String              @id @default(uuid()) @db.Uuid
  slug          String              @unique
  nameAr        String
  descriptionAr String?
  isDemo        Boolean             @default(true)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  products      ProductIngredient[]
}

model ProductIngredient {
  productId    String     @db.Uuid
  ingredientId String     @db.Uuid
  displayOrder Int        @default(0)
  noteAr       String?
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
}

model SkinType {
  id            String                     @id @default(uuid()) @db.Uuid
  slug          String                     @unique
  nameAr        String
  isDemo        Boolean                    @default(true)
  isActive      Boolean                    @default(true)
  compatibility ProductSkinCompatibility[]
}

model SkinConcern {
  id              String                  @id @default(uuid()) @db.Uuid
  slug            String                  @unique
  nameAr          String
  isDemo          Boolean                 @default(true)
  isActive        Boolean                 @default(true)
  productMappings ProductConcernMapping[]
}

model ProductSkinCompatibility {
  productId  String   @db.Uuid
  skinTypeId String   @db.Uuid
  noteAr     String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinType   SkinType @relation(fields: [skinTypeId], references: [id], onDelete: Restrict)

  @@id([productId, skinTypeId])
}

model ProductConcernMapping {
  productId     String      @db.Uuid
  skinConcernId String      @db.Uuid
  noteAr        String?
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinConcern   SkinConcern @relation(fields: [skinConcernId], references: [id], onDelete: Restrict)

  @@id([productId, skinConcernId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Order {
  id                      String                    @id @default(uuid()) @db.Uuid
  reference               String                    @unique
  userId                  String                    @db.Uuid
  status                  OrderStatus               @default(PENDING_PAYMENT)
  currency                String                    @db.VarChar(3)
  subtotal                Decimal                   @db.Decimal(12, 2)
  discountTotal           Decimal                   @default(0) @db.Decimal(12, 2)
  shippingTotal           Decimal                   @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal                   @default(0) @db.Decimal(12, 2)
  total                   Decimal                   @db.Decimal(12, 2)
  shippingAddressSnapshot Json
  shippingMethodSnapshot  Json
  couponSnapshot          Json?
  paymentMethod           PaymentMethod
  paymentStatus           PaymentStatus             @default(PENDING)
  paymentReference        String?
  customerNotes           String?
  internalNote            String?
  shippingReference       String?
  paymentConfirmedAt      DateTime?
  paymentConfirmedById    String?                   @db.Uuid
  idempotencyKey          String                    @unique
  couponId                String?                   @db.Uuid
  cancelledAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon                  Coupon?                   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  reviews                 Review[]
  statusHistory           OrderStatusHistory[]
  couponRedemption        CouponRedemption?
  inventoryMovements      InventoryMovement[]
  cancellationRequest     OrderCancellationRequest?
  paymentConfirmedBy      User?                     @relation("PaymentConfirmer", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @db.Uuid
  variantId     String?         @db.Uuid
  productNameAr String
  variantNameAr String?
  productSlug   String
  sizeLabel     String?
  imageUrl      String?
  currency      String          @db.VarChar(3)
  sku           String
  quantity      Int
  unitPrice     Decimal         @db.Decimal(12, 2)
  total         Decimal         @db.Decimal(12, 2)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews       Review[]

  @@index([orderId])
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  type             CouponType         @default(FIXED)
  value            Decimal            @db.Decimal(12, 2)
  currency         String?            @db.VarChar(3)
  minimumSubtotal  Decimal?           @db.Decimal(12, 2)
  maximumDiscount  Decimal?           @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int                @default(1)
  usageCount       Int                @default(0)
  isDemo           Boolean            @default(true)
  isActive         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orders           Order[]
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @db.Uuid
  userId    String   @db.Uuid
  orderId   String   @unique @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, userId, createdAt])
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  noteAr     String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  variantId      String                @db.Uuid
  orderId        String?               @db.Uuid
  type           InventoryMovementType
  quantity       Int
  balanceAfter   Int
  actorUserId    String?               @db.Uuid
  reason         String?
  note           String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor          User?                 @relation("InventoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([orderId, variantId, type])
  @@index([variantId, createdAt])
}

model OrderCancellationRequest {
  id        String                    @id @default(uuid()) @db.Uuid
  orderId   String                    @unique @db.Uuid
  userId    String                    @db.Uuid
  reason    String
  status    CancellationRequestStatus @default(APPROVED)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  order     Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model CheckoutAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  idempotencyKey String    @unique
  orderId        String?   @unique @db.Uuid
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([userId, createdAt])
}

model Review {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  productId        String       @db.Uuid
  orderId          String       @db.Uuid
  orderItemId      String?      @db.Uuid
  rating           Int
  title            String?
  body             String?
  status           ReviewStatus @default(PENDING)
  moderationReason String?
  moderatedAt      DateTime?
  moderatedById    String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderatedBy      User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([userId, orderId, productId])
  @@index([productId, status])
}

model AssessmentQuestion {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String
  version     Int
  textAr      String
  type        QuestionType
  isRequired  Boolean                @default(false)
  isSensitive Boolean                @default(true)
  status      RecordStatus           @default(DRAFT)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  options     AssessmentOption[]
  answers     SkinAssessmentAnswer[]

  @@unique([code, version])
  @@index([status, version, sortOrder])
}

model AssessmentOption {
  id         String                 @id @default(uuid()) @db.Uuid
  questionId String                 @db.Uuid
  value      String
  labelAr    String
  sortOrder  Int                    @default(0)
  question   AssessmentQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    SkinAssessmentAnswer[]

  @@unique([questionId, value])
}

model SkinAssessment {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @db.Uuid
  questionnaireVersion Int
  status               AssessmentStatus       @default(DRAFT)
  consentVersion       String?
  submittedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers              SkinAssessmentAnswer[]
  recommendations      Recommendation[]
  bookings             ConsultationBooking[]

  @@index([userId, createdAt])
}

model SkinAssessmentAnswer {
  id           String             @id @default(uuid()) @db.Uuid
  assessmentId String             @db.Uuid
  questionId   String             @db.Uuid
  optionId     String?            @db.Uuid
  valueText    String?
  valueBoolean Boolean?
  createdAt    DateTime           @default(now())
  assessment   SkinAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option       AssessmentOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([assessmentId, questionId])
}

model Recommendation {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  assessmentId       String               @db.Uuid
  rulesetVersion     String
  productDataVersion String
  status             RecommendationStatus
  explanationAr      String?
  referralCode       String?
  createdAt          DateTime             @default(now())
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  assessment         SkinAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  items              RecommendationItem[]

  @@index([userId, createdAt])
}

model RecommendationItem {
  id               String         @id @default(uuid()) @db.Uuid
  recommendationId String         @db.Uuid
  productId        String         @db.Uuid
  rank             Int
  reasonCode       String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([recommendationId, productId])
}

model RecommendationRule {
  id             String       @id @default(uuid()) @db.Uuid
  code           String
  version        Int
  titleAr        String
  descriptionAr  String?
  ruleDefinition Json
  status         RecordStatus @default(DRAFT)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([code, version])
  @@index([status, version])
}

model SpecialistProfile {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @unique @db.Uuid
  publicNameAr           String
  bioAr                  String?
  qualificationSummaryAr String?
  verificationStatus     RecordStatus             @default(DRAFT)
  verifiedAt             DateTime?
  verificationExpiresAt  DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  availability           SpecialistAvailability[]
  bookings               ConsultationBooking[]
}

model SpecialistAvailability {
  id           String            @id @default(uuid()) @db.Uuid
  specialistId String            @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  timezone     String
  isAvailable  Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  specialist   SpecialistProfile @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, startsAt, endsAt])
}

model ConsultationBooking {
  id               String             @id @default(uuid()) @db.Uuid
  reference        String             @unique
  customerId       String             @db.Uuid
  specialistId     String             @db.Uuid
  assessmentId     String?            @db.Uuid
  status           BookingStatus      @default(DRAFT)
  startsAt         DateTime
  endsAt           DateTime
  timezone         String
  shareAssessment  Boolean            @default(false)
  meetingMethod    String?
  meetingReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         User               @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  specialist       SpecialistProfile  @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  assessment       SkinAssessment?    @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  notes            ConsultationNote[]

  @@index([specialistId, startsAt, status])
  @@index([customerId, createdAt])
}

model ConsultationNote {
  id                 String              @id @default(uuid()) @db.Uuid
  bookingId          String              @db.Uuid
  authorSpecialistId String              @db.Uuid
  body               String
  isCustomerVisible  Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  booking            ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt])
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  channel     String
  templateKey String
  status      NotificationStatus @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
}

model ConsentRecord {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  purpose       String
  policyVersion String
  action        ConsentAction
  occurredAt    DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, occurredAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentEntry {
  id        String       @id @default(uuid()) @db.Uuid
  key       String       @unique
  type      String
  titleAr   String?
  bodyAr    String?
  url       String?
  status    RecordStatus @default(DRAFT)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type, status, sortOrder])
}
